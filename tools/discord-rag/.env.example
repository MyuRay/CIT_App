# Copy to .env.<firebase-project-id>; never commit the real file.
RAG_REGION=us-central1
RAG_SERVICE_ACCOUNT=rag-bot@YOUR_PROJECT_ID.iam.gserviceaccount.com
RAG_DISCORD_PUBLIC_KEY=
RAG_DISCORD_APPLICATION_ID=
RAG_DISCORD_GUILD_ID=
RAG_DISCORD_CHANNEL_IDS=
RAG_DISCORD_ROLE_IDS=
RAG_REPOSITORY_URL=
RAG_ENABLED=false
RAG_MIN_INSTANCES=0
RAG_GENERATION_MODEL=gemini-3.1-flash-lite
RAG_USER_DAILY_LIMIT=30
RAG_GUILD_DAILY_LIMIT=150
# RAG_GEMINI_API_KEY belongs in Secret Manager, not this file.
# RAG_DISCORD_BOT_TOKEN is used locally for command registration only.
