# ローカル専用（Git にコミットしない）
# cp .env.example .env して値を入れる
#
# Discord 通知（Functions v2 デプロイ時に .env から読み込まれる）
# 旧 functions:config の discord.* は v2 では自動適用されないため、ここへ移行すること
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL_USERS=
DISCORD_WEBHOOK_URL_CONTACTS=
DISCORD_WEBHOOK_URL_BULLETIN=
DISCORD_WEBHOOK_URL_COUPON=
DISCORD_WEBHOOK_URL_CWITTER=
DISCORD_WEBHOOK_URL_MENU=
DISCORD_WEBHOOK_URL_MENU_IMAGE=
DISCORD_WEBHOOK_URL_REVIEW=
DISCORD_WEBHOOK_URL_COMMENT=
DISCORD_WEBHOOK_URL_REPORT=
DISCORD_WEBHOOK_URL_CHIBA_CHANNEL_THREAD=
DISCORD_WEBHOOK_URL_CHIBA_CHANNEL_REPLY=

ODPT_ACL_CONSUMER_KEY=
# mock | static | odpt
TRAIN_INFO_MODE=static

# ODPT 時刻表が0件のとき mock にフォールバック（本番確認時は false）
TRAIN_INFO_ODPT_FALLBACK_MOCK=true

# 参考: Step2-1 で確認した津田沼駅 URI
# TS_STATION_URI=odpt.Station:JR-East.ChuoSobuLocal.Tsudanuma
