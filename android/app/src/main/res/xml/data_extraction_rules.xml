<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Exclude both the session and its device-bound keyset, for every app ID.
         Prefix-only paths do not match Firebase's suffixed preference files. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
