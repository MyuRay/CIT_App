<?xml version="1.0" encoding="utf-8"?>
<!-- CIT App stylish launch splash screen -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/launch_gradient" />

    <!-- Large subtle outer glow -->
    <item android:gravity="center">
        <shape android:shape="oval">
            <size android:width="300dp" android:height="300dp" />
            <solid android:color="#22FFFFFF" />
        </shape>
    </item>

    <!-- Inner soft glow -->
    <item android:gravity="center">
        <shape android:shape="oval">
            <size android:width="210dp" android:height="210dp" />
            <solid android:color="#44FFFFFF" />
        </shape>
    </item>

    <!-- Thin ring accent -->
    <item android:gravity="center">
        <shape android:shape="oval">
            <size android:width="230dp" android:height="230dp" />
            <stroke android:width="1dp" android:color="#55FFFFFF" />
            <solid android:color="#00FFFFFF" />
        </shape>
    </item>

    <!-- App icon -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
