<?xml version="1.0" encoding="utf-8"?>
<!-- 小さいときは上寄せ、大きいときはコンテンツが正しい位置に表示 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:gravity="top"
    android:background="@drawable/widget_surface_bg">

    <!-- ヘッダー: 曜日と日付 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">
        <TextView
            android:id="@+id/today_weekday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="月"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textColor="@color/widget_accent" />
        <TextView
            android:id="@+id/today_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1/1"
            android:textSize="14sp"
            android:textColor="@color/widget_secondary"
            android:layout_marginStart="8dp" />
        <TextView
            android:id="@+id/today_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="end"
            android:layout_marginStart="8dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="今日の時間割"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="@color/widget_on_surface" />
    </LinearLayout>

    <!-- 授業リスト -->
    <LinearLayout
        android:id="@+id/classes_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />

    <!-- 授業がない場合のメッセージ -->
    <TextView
        android:id="@+id/empty_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="今日は授業がありません"
        android:textSize="13sp"
        android:textColor="@color/widget_secondary"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/today_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textSize="10sp"
        android:textColor="@color/widget_secondary" />
</LinearLayout>
