<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_surface_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

    <TextView
        android:id="@+id/bus_title"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:text="学バス情報"
        android:textStyle="bold"
        android:textColor="@color/widget_on_surface"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="16sp"
        android:paddingBottom="6dp" />

    <TextView
        android:id="@+id/btn_refresh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="開く"
        android:contentDescription="アプリを開いて学バス時刻表を更新"
        android:gravity="center"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:textColor="@color/widget_accent"
        android:textSize="12sp"
        android:padding="8dp"
        android:layout_gravity="end"
        android:layout_marginBottom="4dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/route_1_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="4dp">
        <TextView
            android:id="@+id/route_1_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textColor="@color/widget_secondary"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/route_1_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_on_surface"
            android:textStyle="bold"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/route_2_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/route_2_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textColor="@color/widget_secondary"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/route_2_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_on_surface"
            android:textStyle="bold"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/bus_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/widget_secondary"
        android:paddingTop="6dp" />

</LinearLayout>
